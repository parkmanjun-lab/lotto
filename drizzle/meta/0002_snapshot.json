      "checkConstraints": {
        "lotto_recommendations_numbers": {
          "name": "lotto_recommendations_numbers",
          "value": "(\"lotto_recommendations\".\"combinations_json\" IS NULL AND \"lotto_recommendations\".\"details_pruned\" = 1) OR (json_valid(\"lotto_recommendations\".\"combinations_json\") AND json_type(\"lotto_recommendations\".\"combinations_json\") = 'array' AND ((\"lotto_recommendations\".\"details_pruned\" = 0 AND json_array_length(\"lotto_recommendations\".\"combinations_json\") = 10) OR (\"lotto_recommendations\".\"details_pruned\" = 1 AND json_array_length(\"lotto_recommendations\".\"combinations_json\") BETWEEN 1 AND 10)))"
        },
        "lotto_recommendations_window": {
          "name": "lotto_recommendations_window",
          "value": "\"lotto_recommendations\".\"analysis_window\" IN (20, 50, 100)"
        },
        "lotto_recommendations_target": {
          "name": "lotto_recommendations_target",
          "value": "\"lotto_recommendations\".\"analyzed_round\" > 0 AND \"lotto_recommendations\".\"analyzed_round\" < \"lotto_recommendations\".\"target_round\" AND \"lotto_recommendations\".\"accepted_at\" < \"lotto_recommendations\".\"cutoff_at\""
        },
        "lotto_recommendations_settlement": {
          "name": "lotto_recommendations_settlement",
          "value": "\"lotto_recommendations\".\"settled_at\" IS NULL OR \"lotto_recommendations\".\"losing_count\" + \"lotto_recommendations\".\"rank1_count\" + \"lotto_recommendations\".\"rank2_count\" + \"lotto_recommendations\".\"rank3_count\" + \"lotto_recommendations\".\"rank4_count\" + \"lotto_recommendations\".\"rank5_count\" = 10"
        }
